/// A workspace or group that owns Secrets and has Members.
/// Each Team is owned by a single User and can have multiple
/// TeamMember join records and TeamInvite links.
model Team {
  id   String @id @default(cuid())
  uuid String @unique @default(uuid())

  name String
  slug String @unique

  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id])

  members     TeamMember[]
  teamInvites TeamInvite[]
  secrets     Secret[]     @relation("secret_team")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("teams")
}

/// Join table linking a User to a Team with a specific role.
/// Tracks granular permission assignments and provides audit
/// trails for Secret creation and modification by this member.
model TeamMember {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  teamId String @map("team_id")
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  role TeamMemberRole @default(MEMBER)

  joinedAt DateTime @default(now()) @map("joined_at")

  permissions      TeamMemberPermissionAssignment[] @relation("MemberPermissions")
  addedPermissions TeamMemberPermissionAssignment[] @relation("PermissionAddedBy")

  secretsAdded   Secret[] @relation("secret_added_by")
  secretsUpdated Secret[] @relation("secret_updated_by")

  @@map("team_members")
}

/// An invitation link that allows a user to join a Team.
/// Each invite is identified by a unique slug and expires
/// after a set duration.
model TeamInvite {
  id String @id @default(cuid())

  teamId String @map("team_id")
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  slug String @unique

  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@map("team_invites")
}

/// Grants a specific TeamMemberPermission to a TeamMember.
/// Allows composing custom access policies beyond the base role.
model TeamMemberPermissionAssignment {
  id String @id @default(cuid())

  teamMemberId String     @map("team_member_id")
  teamMember   TeamMember @relation("MemberPermissions", fields: [teamMemberId], references: [id], onDelete: Cascade)

  addedBy     String     @map("added_by")
  addedByUser TeamMember @relation("PermissionAddedBy", fields: [addedBy], references: [id])

  permission TeamMemberPermission

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("team_member_permission_assignments")
}
