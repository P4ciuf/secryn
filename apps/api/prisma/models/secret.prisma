/// A named secret value stored within a Team.
/// Secrets are key-value pairs with optional notes, and their
/// creation and modification are attributed to a TeamMember.
model Secret {
  id String @id @default(cuid())

  name  String
  value String
  notes String

  addedById String     @map("added_by")
  addedBy   TeamMember @relation("secret_added_by", fields: [addedById], references: [id])

  updatedById String     @map("updated_by")
  updatedBy   TeamMember @relation("secret_updated_by", fields: [updatedById], references: [id])

  teamId String @map("team_id")
  team   Team   @relation("secret_team", fields: [teamId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("secrets")
}
