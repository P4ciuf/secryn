/// A named secret value stored within a Project.
/// Secrets are key-value pairs with optional notes, and their
/// creation and modification are attributed to a ProjectMember.
/// The value is encrypted at rest before being persisted.
model Secret {
  id String @id @default(cuid())

  /// The key used to identify this secret within the project.
  name  String
  /// The secret payload; encrypted before storage.
  value String
  /// Optional human-readable description or metadata for the secret.
  notes String

  /// The ProjectMember who created this secret.
  addedById String        @map("added_by")
  addedBy   ProjectMember @relation("secret_added_by", fields: [addedById], references: [id])

  /// The ProjectMember who last modified this secret.
  updatedById String        @map("updated_by")
  updatedBy   ProjectMember @relation("secret_updated_by", fields: [updatedById], references: [id])

  projectId String  @map("project_id")
  /// The parent project this secret belongs to.
  project   Project @relation("secret_project", fields: [projectId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("secrets")
}
