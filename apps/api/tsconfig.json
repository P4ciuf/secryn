{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "allowJs": true,

    "outDir": "./dist",
    "rootDir": ".",

    "types": ["node"],
    "verbatimModuleSyntax": true,
    "resolvePackageJsonExports": true
  },
  "include": ["src/**/*", "prisma/**/*", "prisma.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
