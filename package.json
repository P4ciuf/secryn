{
  "name": "secryn-monorepo",
  "private": true,
  "description": "secryn is a secure, developer-focused secrets management platform. Store, encrypt, and access API keys, tokens, and environment variables safely through a dashboard and API",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "test:coverage": "pnpm -r test:coverage",
    "test:ci": "pnpm -r test:coverage",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "lint:staged": "eslint --cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build",
    "docker:dev": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v",
    "docker:logs": "docker compose logs -f",
    "docker:logs:api": "docker compose logs -f api",
    "docker:logs:web": "docker compose logs -f web",
    "docker:logs:db": "docker compose logs -f db",
    "dev": "pnpm --filter app dev",
    "db:generate": "pnpm --filter app prisma:generate",
    "db:push": "pnpm --filter app prisma:push",
    "db:migrate": "pnpm --filter app prisma:migrate",
    "db:studio": "pnpm --filter app prisma:studio",
    "prepare": "husky"
  },
  "author": "P4ciuf | https://github.com/P4ciuf",
  "license": "Apache-2.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.5.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@eslint/css": "^1.3.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.0",
    "@eslint/markdown": "^8.0.2",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/coverage-v8": "^4.1.7",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.6",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "pnpm exec eslint --fix",
      "pnpm exec prettier --write"
    ],
    "*.{css,json,md,yaml,yml}": [
      "pnpm exec prettier --write"
    ]
  }
}
