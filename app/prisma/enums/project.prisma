/// Fine-grained operations a ProjectMember can be authorized to perform.
/// These can be assigned individually to compose custom access policies.
enum ProjectMemberPermission {
  READ_SECRETS   @map("read_secrets")
  CREATE_SECRETS @map("create_secrets")
  UPDATE_SECRETS @map("update_secrets")
  DELETE_SECRETS @map("delete_secrets")

  CREATE_INVITES @map("create_invites")
  DELETE_INVITES @map("delete_invites")

  /// Add members and assign/revoke their permissions (does not include removal).
  MANAGE_MEMBERS @map("manage_members")
  /// Remove a member from the project entirely.
  REMOVE_MEMBERS @map("remove_members")

  /// Grants every available permission in the system.
  ALL @map("all")
}
