/// Single-use token for resetting a forgotten password.
/// Generated when the user requests a password reset via email and expired
/// after 1 hour. Marked as consumed once the password has been reset.
model PasswordResetToken {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The plaintext token sent to the user's email; since tokens are
  /// cryptographically random and short-lived, they are stored directly
  /// rather than hashed for simplicity of lookup.
  token     String   @unique

  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}
