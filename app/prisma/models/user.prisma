/// Represents a registered user account in the system.
/// A User authenticates via email and password and participates in
/// Projects through the ProjectMember join table (many-to-many relationship).
/// Each User can own multiple Projects and be a member of many others.
/// UserBan records track moderation actions against the account.
model User {
  id String @id @default(cuid())

  /// Primary login identifier; used during authentication.
  email    String @unique
  /// Bcrypt-hashed password; never stored in plain text.
  password String

  /// Publicly visible unique handle displayed across the platform.
  username String   @unique
  /// Defaults to USER for self-registered accounts.
  role     UserRole @default(USER)

  /// Whether the user's email address has been confirmed.
  isVerified Boolean @default(false) @map("is_verified")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Ban records applied to this account.
  bans             UserBan[]         @relation("banned_user")
  /// Ban records this user has placed on other accounts.
  addedBans        UserBan[]         @relation("added_by_user")
  /// Project memberships this user belongs to.
  members          ProjectMember[]
  /// Projects for which this user is the owner.
  projects         Project[]
  /// API keys created by this user.
  apiKeys          ApiKey[]
  /// Password reset tokens requested by this user.
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

/// Records a moderation action that restricts a User's access.
/// Supports temporary (with expiresAt) and permanent (isPermanent) bans,
/// as well as manual reversal via isRevoked / revokedAt.
/// Tracks the IP address at the time of the ban for audit purposes.
model UserBan {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation("banned_user", fields: [userId], references: [id], onDelete: Cascade)

  /// The user who placed this ban.
  addedBy     String @map("added_by")
  addedByUser User   @relation("added_by_user", fields: [addedBy], references: [id])

  /// Free-text explanation for why the ban was applied.
  reason    String
  /// The IP address of the user at the time the ban was applied.
  ipAddress String @map("ip_address")

  /// When true, the ban never expires automatically; expiresAt is ignored.
  isPermanent Boolean @default(false) @map("is_permanent")

  createdAt DateTime  @default(now()) @map("created_at")
  /// Optional expiry date for temporary bans; ignored when isPermanent is true.
  expiresAt DateTime? @map("expires_at")

  /// When true, the ban has been manually lifted before its expiration.
  isRevoked Boolean   @default(false) @map("is_revoked")
  /// Timestamp recording when the ban was manually revoked.
  revokedAt DateTime? @map("revoked_at")

  @@map("user_bans")
}
